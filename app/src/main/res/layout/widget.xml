<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="18dp" android:background="@drawable/cyber_circle">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◈ IING STD" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="21sp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CYBER MONITOR" android:textStyle="bold" android:textColor="#00FF77" android:textSize="13sp"/>
  <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="hh:mm:ss" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
  <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEE, dd MMM yyyy" android:format24Hour="EEE, dd MMM yyyy" android:textColor="#D9FFE7" android:textSize="11sp"/>
  <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/portrait" android:contentDescription="Foto profil" android:layout_marginTop="8dp"/>
  <TextView android:id="@+id/network" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📶 Memeriksa jaringan" android:textColor="#00FF77" android:textSize="12sp"/>
  <TextView android:id="@+id/signal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sinyal: --" android:textColor="#00FFCC" android:textSize="11sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="9dp">
   <TextView android:id="@+id/battery" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:text="BAT --" android:textColor="#55FF55" android:textSize="13sp"/>
   <TextView android:id="@+id/storage" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:text="RAM --" android:textColor="#00DDFF" android:textSize="13sp"/>
   <TextView android:id="@+id/temp" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:text="TEMP --" android:textColor="#FFB32C" android:textSize="13sp"/>
  </LinearLayout>
  <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻ Sentuh untuk segarkan" android:textColor="#00FF77" android:textSize="10sp" android:layout_marginTop="10dp"/>
 </LinearLayout>
</FrameLayout>