<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/cyber_circle">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◈ IING STD" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="8sp" android:includeFontPadding="false"/>
<TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="22sp" android:includeFontPadding="false"/>
<TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#B8F9D1" android:textSize="8sp" android:includeFontPadding="false"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="3dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
<LinearLayout android:layout_width="wrap_content" android:layout_height="20dp" android:gravity="bottom" android:orientation="horizontal">
<TextView android:id="@+id/bar1" android:layout_width="4dp" android:layout_height="6dp" android:layout_marginEnd="2dp" android:background="#00DDFF" android:text=" "/>
<TextView android:id="@+id/bar2" android:layout_width="4dp" android:layout_height="10dp" android:layout_marginEnd="2dp" android:background="#00DDFF" android:text=" "/>
<TextView android:id="@+id/bar3" android:layout_width="4dp" android:layout_height="15dp" android:layout_marginEnd="2dp" android:background="#00DDFF" android:text=" "/>
<TextView android:id="@+id/bar4" android:layout_width="4dp" android:layout_height="19dp" android:background="#00DDFF" android:text=" "/>
</LinearLayout>
<TextView android:id="@+id/network" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seluler" android:textColor="#FFFFFF" android:textSize="8sp" android:maxLines="1" android:includeFontPadding="false"/>
<TextView android:id="@+id/signal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--/4" android:textColor="#00FF77" android:textSize="7sp" android:maxLines="1" android:includeFontPadding="false"/>
</LinearLayout>
<ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/portrait" android:contentDescription="Foto profil"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#00FF77" android:textSize="18sp" android:includeFontPadding="false"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CYBER" android:textColor="#FFFFFF" android:textSize="7sp" android:includeFontPadding="false"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
<TextView android:id="@+id/battery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="BAT --" android:textColor="#55FF55" android:textSize="8sp" android:maxLines="1" android:includeFontPadding="false"/>
<TextView android:id="@+id/storage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="RAM --" android:textColor="#00DDFF" android:textSize="8sp" android:maxLines="1" android:includeFontPadding="false"/>
</LinearLayout>
<TextView android:id="@+id/temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°C" android:textColor="#FFB32C" android:textSize="8sp" android:includeFontPadding="false"/>
<TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻ Perbarui" android:textColor="#00FF77" android:textSize="7sp" android:includeFontPadding="false"/>
</LinearLayout>
</FrameLayout>